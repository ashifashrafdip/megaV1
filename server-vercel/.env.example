# Neon PostgreSQL connection string (pooled recommended)
DATABASE_URL="postgres://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret key for JWT signing (64+ chars recommended)
JWT_SECRET="dev_jwt_secret_change_before_production_use_64chars_minimum_abc123"

# Desktop app API key (must match "auth.app_key" in desktop config.json)
APP_API_KEY="dev-desktop-app-key-change-me"

# Admin session cookie secret
SESSION_SECRET="admin_session_secret_change_in_production_key_xyz_98765"

# Security & limits
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
SESSION_TIMEOUT=3600
HEARTBEAT_INTERVAL=45
LOGIN_RATE_LIMIT=5
